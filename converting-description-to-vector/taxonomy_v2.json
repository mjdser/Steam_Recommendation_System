{
  "taxonomy_version": "taxonomy_v2",
  "model_config_version": "bge_hybrid_v1",
  "score_semantics": {
    "range": [
      0.0,
      1.0
    ],
    "meaning": "Strength of textual evidence that the cleaned game description supports the label. Not calibrated probabilities, not game quality, and not Steam tag vote shares. Multiple labels may score highly; scores need not sum to 1.",
    "method": "Hybrid of (1) sentence-embedding cosine similarity between the description and fixed label definitions, retaining embedding mass only for the top-k genres and top-k tags per game (similarity-derived, not probabilities), and (2) keyword/regex evidence with simple negation handling. Outputs are hybrid textual-evidence scores in [0,1].",
    "score_type": "hybrid_embedding_similarity_and_keyword_evidence"
  },
